{
  "name": "@tele-photo/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:telegram": "tsx --env-file-if-exists=../.env scripts/verify-telegram.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "big-integer": "^1.6.52",
    "exifr": "^7.1.3",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
