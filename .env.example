# Get these two from https://my.telegram.org -> "API development tools".
# They identify this app to Telegram. They are not your login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where the server listens. 127.0.0.1 means this computer only.
# To open it from your phone on the same Wi-Fi use HOST=0.0.0.0, and set
# TP_ALLOWED_PHONES below so nobody else on the network can sign in.
HOST=127.0.0.1
PORT=8787

# Comma-separated phone numbers allowed to sign in, e.g. +15551234567,+919800000000
# Leave empty to allow any Telegram account.
TP_ALLOWED_PHONES=

# Set to true only when serving over HTTPS (for example behind a reverse proxy).
TP_COOKIE_SECURE=false

# Days a photo stays in Trash before it is permanently deleted from Telegram.
TP_TRASH_RETENTION_DAYS=30

# Where the index, thumbnails and your encrypted Telegram session are kept.
TP_DATA_DIR=./data

# "telegram" for real use. "fake" keeps files on this disk instead of Telegram and
# accepts any phone with code 12345. It exists for development and tests only.
TP_STORAGE=telegram
