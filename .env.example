# Get these two from https://my.telegram.org -> "API development tools".
# They identify this app to Telegram. They are not your login.
#
# VITE_ means these are built into the site's code, where anyone can read them. That is
# normal for a Telegram client, and every Telegram app works this way. What matters is that
# they are yours, because Telegram holds the owner of the key responsible for how it is used.
VITE_TELEGRAM_API_ID=
VITE_TELEGRAM_API_HASH=

# Days a photo stays in Trash before it is permanently deleted from Telegram.
# It happens the next time the app is open after that, so never early.
VITE_TRASH_RETENTION_DAYS=30

# Leave this unset for real use. "fake" keeps files in the browser instead of Telegram and
# accepts any phone with code 12345. It exists for development and demos only.
# VITE_STORAGE=fake
